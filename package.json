{
  "name": "d365fo-ai-co-lead",
  "displayName": "D365 Finance & Operations AI Co-Lead",
  "description": "AI-powered cockpit for the entire D365 F&O delivery lifecycle. Role-aware dashboards (Architect, FC, Dev Lead, Developer, Tester, PM), an in-product Agent Factory, and Copilot chat partners powered by D365FODevMCP, DevMachine and ADO MCP servers.",
  "version": "1.1.0",
  "publisher": "vinodkumarkj12",
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Other",
    "Chat",
    "AI"
  ],
  "keywords": [
    "d365",
    "dynamics 365",
    "finance and operations",
    "f&o",
    "x++",
    "azure devops",
    "nuget",
    "ai",
    "agent",
    "copilot",
    "co-lead",
    "mcp"
  ],
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/vjanardhana12/d365fo-ai-co-lead.git"
  },
  "license": "MIT",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "d365fo",
          "title": "D365 F&O AI Co-Lead",
          "icon": "media/activitybar.svg"
        }
      ]
    },
    "views": {
      "d365fo": [
        {
          "id": "d365fo.connections",
          "name": "Project Connections",
          "icon": "media/activitybar.svg",
          "contextualTitle": "D365 F&O Project Connections"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "d365fo.connections",
        "contents": "A project connection holds your Microsoft sign-in + ADO project (one per ADO project), plus an optional SharePoint site URL. No PAT required - signs you in to Azure DevOps via your Microsoft account.\n\n[+ Add project connection](command:d365fo.connections.add)\n[Open dashboard](command:d365fo.openDashboard)\n\n[Learn more](https://github.com/vjanardhana12/d365fo-ai-co-lead#readme)"
      }
    ],
    "commands": [
      {
        "command": "d365fo.openDashboard",
        "title": "D365FO: Open Dashboard",
        "icon": "$(dashboard)"
      },
      {
        "command": "d365fo.refresh",
        "title": "D365FO: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "d365fo.connections.add",
        "title": "Add Project Connection",
        "icon": "$(add)"
      },
      {
        "command": "d365fo.connections.edit",
        "title": "Edit Project Connection",
        "icon": "$(edit)"
      },
      {
        "command": "d365fo.connections.delete",
        "title": "Delete Project Connection",
        "icon": "$(trash)"
      },
      {
        "command": "d365fo.connections.test",
        "title": "Test Connection",
        "icon": "$(plug)"
      },
      {
        "command": "d365fo.connections.setActive",
        "title": "Set as Active",
        "icon": "$(star)"
      },
      {
        "command": "d365fo.connections.openPatPage",
        "title": "D365FO: Open ADO PAT Page",
        "icon": "$(key)"
      },
      {
        "command": "d365fo.nugetSync.run",
        "title": "D365FO: Run NuGet Sync",
        "icon": "$(sync)"
      },
      {
        "command": "d365fo.nugetSync.showOutput",
        "title": "D365FO: Show NuGet Sync Output",
        "icon": "$(output)"
      },
      {
        "command": "d365fo.devTasks.create",
        "title": "D365FO: Create Dev Tasks (ADO)",
        "icon": "$(checklist)"
      },
      {
        "command": "d365fo.devTasks.showOutput",
        "title": "D365FO: Show Dev Tasks Output",
        "icon": "$(output)"
      },
      {
        "command": "d365fo.projectKit.init",
        "title": "D365FO: Project Initiation Kit",
        "icon": "$(rocket)"
      },
      {
        "command": "d365fo.cbSpecKit.edit",
        "title": "D365FO: Edit CB Spec Kit",
        "icon": "$(settings-gear)"
      },
      {
        "command": "d365fo.agents.manage",
        "title": "D365FO: Manage Agents",
        "icon": "$(person-add)"
      },
      {
        "command": "d365fo.agents.invoke",
        "title": "D365FO: Ask an Agent",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "d365fo.devTasks.askAi",
        "title": "D365FO: Dev Tasks - Ask AI for plan",
        "icon": "$(sparkle)"
      },
      {
        "command": "d365fo.setRoles",
        "title": "D365FO: Set My Role(s)",
        "icon": "$(person)"
      },
      {
        "command": "d365fo.sharepoint.browse",
        "title": "D365FO: Browse SharePoint files",
        "icon": "$(cloud)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "d365fo.openDashboard",
          "when": "view == d365fo.connections",
          "group": "navigation@0"
        },
        {
          "command": "d365fo.connections.add",
          "when": "view == d365fo.connections",
          "group": "navigation@1"
        },
        {
          "command": "d365fo.refresh",
          "when": "view == d365fo.connections",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "d365fo.connections.setActive",
          "when": "view == d365fo.connections && viewItem == connection",
          "group": "1@1"
        },
        {
          "command": "d365fo.connections.test",
          "when": "view == d365fo.connections && viewItem == connection",
          "group": "1@2"
        },
        {
          "command": "d365fo.connections.edit",
          "when": "view == d365fo.connections && viewItem == connection",
          "group": "2@1"
        },
        {
          "command": "d365fo.connections.delete",
          "when": "view == d365fo.connections && viewItem == connection",
          "group": "9@1"
        }
      ]
    },
    "chatParticipants": [
      {
        "id": "d365fo.coLead",
        "name": "d365fo-co-lead",
        "fullName": "D365 F&O AI Co-Lead",
        "description": "Master orchestrator across the F&O delivery lifecycle. Routes to role-specific agents (architect, fc, dev-lead, developer, tester, pm).",
        "isSticky": true,
        "commands": [
          {
            "name": "dashboard",
            "description": "Open the AI Co-Lead dashboard"
          },
          {
            "name": "connections",
            "description": "List configured project connections"
          },
          {
            "name": "agents",
            "description": "List available agents"
          },
          {
            "name": "role",
            "description": "Show or set your active role(s)"
          }
        ]
      },
      {
        "id": "d365fo.architect",
        "name": "d365fo-architect",
        "fullName": "D365 F&O Architect (AI Co-Lead)",
        "description": "Solution / delivery architect partner. HLD, integration design, ARB readiness.",
        "isSticky": true
      },
      {
        "id": "d365fo.fc",
        "name": "d365fo-fc",
        "fullName": "D365 F&O Functional Consultant (AI Co-Lead)",
        "description": "FC partner. FDD authoring, fit-gap, configuration workbook, UAT scripts.",
        "isSticky": true
      },
      {
        "id": "d365fo.devLead",
        "name": "d365fo-dev-lead",
        "fullName": "D365 F&O Dev Lead (AI Co-Lead)",
        "description": "Dev lead partner. Dev tasks, PR triage, capacity, build / NuGet sync.",
        "isSticky": true,
        "commands": [
          {
            "name": "sync",
            "description": "Run NuGet sync"
          },
          {
            "name": "devtasks",
            "description": "Plan / create ADO Dev Tasks"
          },
          {
            "name": "test",
            "description": "Test the active connection"
          }
        ]
      },
      {
        "id": "d365fo.developer",
        "name": "d365fo-developer",
        "fullName": "D365 F&O Developer (AI Co-Lead)",
        "description": "Developer partner. Implement-from-FDD, fix BP / UT, code coverage, X++ help.",
        "isSticky": true
      },
      {
        "id": "d365fo.tester",
        "name": "d365fo-tester",
        "fullName": "D365 F&O Tester (AI Co-Lead)",
        "description": "Tester partner. Test cases from FDD, ATC/RSAT scripts, defect triage.",
        "isSticky": true
      },
      {
        "id": "d365fo.pm",
        "name": "d365fo-pm",
        "fullName": "D365 F&O PM (AI Co-Lead)",
        "description": "Project manager partner. Status rollup, burndown, risk view (coming soon).",
        "isSticky": true
      }
    ],
    "configuration": {
      "title": "D365 F&O AI Co-Lead",
      "properties": {
        "d365fo.myRoles": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "architect",
              "fc",
              "dev-lead",
              "developer",
              "tester",
              "pm"
            ]
          },
          "default": [
            "dev-lead"
          ],
          "description": "Your role(s) on F&O projects. The dashboard filters tiles to those relevant to these roles. Multi-select for techno-functional or hybrid roles."
        },
        "d365fo.storageMode": {
          "type": "string",
          "enum": [
            "workspace",
            "global"
          ],
          "default": "global",
          "description": "Where to store connections and identities. 'global' shares across all workspaces; 'workspace' keeps them per-folder."
        },
        "d365fo.nugetSyncScript": {
          "type": "string",
          "default": "",
          "description": "Optional override for the Sync-D365FONuGet.ps1 path. Leave blank to use the bundled / cached copy."
        },
        "d365fo.nugetSyncScriptChannel": {
          "type": "string",
          "enum": [
            "latest-release",
            "main"
          ],
          "default": "latest-release",
          "enumDescriptions": [
            "Pull the script from the latest GitHub Release of d365fo-nuget-sync (recommended).",
            "Pull the script from the main branch (bleeding edge - dev only)."
          ],
          "description": "Channel to fetch the NuGet sync PowerShell script from. Ignored if 'd365fo.nugetSyncScript' is set."
        },
        "d365fo.openDashboardOnStartup": {
          "type": "string",
          "enum": [
            "never",
            "ifEmpty",
            "always"
          ],
          "default": "ifEmpty",
          "enumDescriptions": [
            "Never auto-open the dashboard.",
            "Only open when no connections are configured (default).",
            "Open the dashboard every time VS Code starts."
          ],
          "description": "When to auto-open the D365 F&O Dashboard on VS Code startup."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.js",
    "package": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "lint": "tsc --noEmit",
    "vscode:package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.92.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "sharp": "^0.34.5",
    "typescript": "^5.5.0"
  }
}
