{
  "name": "d365fo-devlead",
  "displayName": "D365 F&O Dev Lead",
  "description": "Click-driven dashboard + Copilot chat agent for Dynamics 365 Finance & Operations dev leads. Connections, identities, NuGet sync, PR review, pre-checks, releases.",
  "version": "0.2.4",
  "publisher": "vinodkumarkj",
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Other",
    "Chat",
    "AI"
  ],
  "keywords": [
    "d365",
    "dynamics 365",
    "finance and operations",
    "f&o",
    "x++",
    "azure devops",
    "nuget",
    "dev lead"
  ],
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/vjanardhana12/d365fo-devlead.git"
  },
  "license": "MIT",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "d365fo",
          "title": "D365 F&O Dev Lead",
          "icon": "media/activitybar.svg"
        }
      ]
    },
    "views": {
      "d365fo": [
        {
          "id": "d365fo.identities",
          "name": "Identities",
          "icon": "media/activitybar.svg",
          "contextualTitle": "D365 F&O Identities"
        },
        {
          "id": "d365fo.connections",
          "name": "Connections",
          "icon": "media/activitybar.svg",
          "contextualTitle": "D365 F&O Connections"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "d365fo.identities",
        "contents": "Identities are *who* you authenticate as (display name + email + ADO PAT).\n\n[+ Add identity](command:d365fo.identities.add)\n[Open dashboard](command:d365fo.openDashboard)\n\n[Learn more](https://github.com/vjanardhana12/d365fo-devlead#readme)"
      },
      {
        "view": "d365fo.connections",
        "contents": "Connections bind an identity to an ADO project (one connection per project).\n\n[+ Add connection](command:d365fo.connections.add)\n[Open dashboard](command:d365fo.openDashboard)\n\nAdd an identity first if you haven't yet."
      }
    ],
    "commands": [
      {
        "command": "d365fo.openDashboard",
        "title": "D365FO: Open Dashboard",
        "icon": "$(dashboard)"
      },
      {
        "command": "d365fo.refresh",
        "title": "D365FO: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "d365fo.connections.add",
        "title": "Add Connection",
        "icon": "$(add)"
      },
      {
        "command": "d365fo.connections.edit",
        "title": "Edit Connection",
        "icon": "$(edit)"
      },
      {
        "command": "d365fo.connections.delete",
        "title": "Delete Connection",
        "icon": "$(trash)"
      },
      {
        "command": "d365fo.connections.test",
        "title": "Test Connection",
        "icon": "$(plug)"
      },
      {
        "command": "d365fo.connections.setActive",
        "title": "Set as Active",
        "icon": "$(star)"
      },
      {
        "command": "d365fo.identities.add",
        "title": "Add Identity",
        "icon": "$(add)"
      },
      {
        "command": "d365fo.identities.edit",
        "title": "Edit Identity",
        "icon": "$(edit)"
      },
      {
        "command": "d365fo.identities.delete",
        "title": "Delete Identity",
        "icon": "$(trash)"
      },
      {
        "command": "d365fo.nugetSync.run",
        "title": "D365FO: Run NuGet Sync",
        "icon": "$(sync)"
      },
      {
        "command": "d365fo.nugetSync.showOutput",
        "title": "D365FO: Show NuGet Sync Output",
        "icon": "$(output)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "d365fo.openDashboard",
          "when": "view == d365fo.identities || view == d365fo.connections",
          "group": "navigation@0"
        },
        {
          "command": "d365fo.connections.add",
          "when": "view == d365fo.connections",
          "group": "navigation@1"
        },
        {
          "command": "d365fo.refresh",
          "when": "view == d365fo.connections",
          "group": "navigation@2"
        },
        {
          "command": "d365fo.identities.add",
          "when": "view == d365fo.identities",
          "group": "navigation@1"
        },
        {
          "command": "d365fo.refresh",
          "when": "view == d365fo.identities",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "d365fo.connections.setActive",
          "when": "view == d365fo.connections && viewItem == connection",
          "group": "1@1"
        },
        {
          "command": "d365fo.connections.test",
          "when": "view == d365fo.connections && viewItem == connection",
          "group": "1@2"
        },
        {
          "command": "d365fo.connections.edit",
          "when": "view == d365fo.connections && viewItem == connection",
          "group": "2@1"
        },
        {
          "command": "d365fo.connections.delete",
          "when": "view == d365fo.connections && viewItem == connection",
          "group": "9@1"
        },
        {
          "command": "d365fo.identities.edit",
          "when": "view == d365fo.identities && viewItem == identity",
          "group": "1@1"
        },
        {
          "command": "d365fo.identities.delete",
          "when": "view == d365fo.identities && viewItem == identity",
          "group": "9@1"
        }
      ]
    },
    "chatParticipants": [
      {
        "id": "d365fo.devlead",
        "name": "d365fo",
        "fullName": "D365 F&O Dev Lead",
        "description": "Run dev-lead actions on D365 F&O - connections, NuGet sync, PRs, pre-checks.",
        "isSticky": true,
        "commands": [
          {
            "name": "dashboard",
            "description": "Open the D365 F&O dashboard"
          },
          {
            "name": "connections",
            "description": "List configured connections"
          },
          {
            "name": "test",
            "description": "Test the active connection"
          },
          {
            "name": "sync",
            "description": "Run NuGet sync for the active connection"
          },
          {
            "name": "prs",
            "description": "Show open pull requests (coming soon)"
          },
          {
            "name": "estimate",
            "description": "Estimate a work item (coming soon)"
          }
        ]
      }
    ],
    "configuration": {
      "title": "D365 F&O Dev Lead",
      "properties": {
        "d365fo.storageMode": {
          "type": "string",
          "enum": [
            "workspace",
            "global"
          ],
          "default": "global",
          "description": "Where to store connections and identities. 'global' shares across all workspaces; 'workspace' keeps them per-folder."
        },
        "d365fo.nugetSyncScript": {
          "type": "string",
          "default": "",
          "description": "Optional override for the Sync-D365FONuGet.ps1 path. Leave blank to use the bundled / cached copy."
        },
        "d365fo.nugetSyncScriptChannel": {
          "type": "string",
          "enum": [
            "latest-release",
            "main"
          ],
          "default": "latest-release",
          "enumDescriptions": [
            "Pull the script from the latest GitHub Release of d365fo-nuget-sync (recommended).",
            "Pull the script from the main branch (bleeding edge - dev only)."
          ],
          "description": "Channel to fetch the NuGet sync PowerShell script from. Ignored if 'd365fo.nugetSyncScript' is set."
        },
        "d365fo.openDashboardOnStartup": {
          "type": "string",
          "enum": [
            "never",
            "ifEmpty",
            "always"
          ],
          "default": "ifEmpty",
          "enumDescriptions": [
            "Never auto-open the dashboard.",
            "Only open when no connections are configured (default).",
            "Open the dashboard every time VS Code starts."
          ],
          "description": "When to auto-open the D365 F&O Dashboard on VS Code startup."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.js",
    "package": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "lint": "tsc --noEmit",
    "vscode:package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.92.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.5.0"
  }
}
